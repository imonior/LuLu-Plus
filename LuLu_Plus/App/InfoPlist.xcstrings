        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telif hakkı © 2020 Objective-See. Tüm hakları saklıdır.\nLuLu_Plus, imonior tarafından 2026'da değiştirilmiş bir çatallamadır (github.com/imonior/LuLu-Plus)."
