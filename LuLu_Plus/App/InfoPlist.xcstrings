        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright (c) 2020 Objective-See. Усі права захищені.\nLuLu_Plus — змінений форк від imonior, 2026 (github.com/imonior/LuLu-Plus)."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "کاپی رائٹ (c) 2020 Objective-See۔ تمام حقوق محفوظ ہیں۔\nLuLu_Plus، imonior کا 2026 میں ترمیم شدہ فورک ہے (github.com/imonior/LuLu-Plus)۔"
