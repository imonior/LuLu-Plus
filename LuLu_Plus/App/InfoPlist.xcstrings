    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright (c) 2020 Objective-See. Alle Rechte vorbehalten.\nLuLu_Plus ist ein geänderter Fork von imonior, 2026 (github.com/imonior/LuLu-Plus)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Copyright (c) 2020 Objective-See. All rights reserved.\nLuLu_Plus is a modified fork by imonior, 2026 (github.com/imonior/LuLu-Plus)."
