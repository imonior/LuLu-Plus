        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "版權所有 (c) 2020 Objective-See. 保留一切權利。\nLuLu_Plus 是 imonior 於 2026 年發佈的修改版 fork（github.com/imonior/LuLu-Plus）。"
          }
        }
      }
    },
    "NSLocationUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus liest den Namen dieses WLAN-Netzes (SSID), damit seine Netzwerkprofile in verschiedenen Netzen unterschiedliche Regeln anwenden können. Der Name wird nur an LuLu_Plus eigenen Inhaltsfilter übergeben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "LuLu_Plus reads this Wi-Fi network's name (SSID) so its network profiles can apply different rules on different networks. The name is only passed to LuLu_Plus's own content filter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus lee el nombre de esta red Wi-Fi (SSID) para que sus perfiles de red puedan aplicar reglas distintas en redes distintas. El nombre solo se pasa al filtro de contenido de LuLu_Plus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus lit le nom de ce réseau Wi-Fi (SSID) afin que ses profils réseau puissent appliquer des règles différentes selon le réseau. Ce nom n'est transmis qu'au filtre de contenu de LuLu_Plus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus legge il nome di questa rete Wi-Fi (SSID) in modo che i suoi profili rete possano applicare regole diverse su reti diverse. Il nome viene trasmesso solo al filtro contenuti di LuLu_Plus."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus는 이 Wi-Fi 네트워크의 이름(SSID)을 읽어 네트워크 프로필에서 네트워크마다 다른 규칙을 적용할 수 있도록 합니다. 이 이름은 LuLu_Plus의 콘텐츠 필터에만 전달됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus odczytuje nazwę tej sieci Wi-Fi (SSID), aby profile sieci mogły stosować różne reguły w różnych sieciach. Nazwa jest przekazywana wyłącznie do filtra treści LuLu_Plus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O LuLu_Plus lê o nome desta rede Wi-Fi (SSID) para que seus perfis de rede possam aplicar regras diferentes em redes diferentes. O nome é enviado apenas ao filtro de conteúdo do LuLu_Plus."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus, ağ profillerinin farklı ağlarda farklı kurallar uygulayabilmesi için bu Wi-Fi ağının adını (SSID) okur. Ad yalnızca LuLu_Plus'nun içerik filtresine aktarılır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus читає назву цієї Wi-Fi мережі (SSID), щоб її мережеві профілі могли застосовувати різні правила в різних мережах. Назва передається лише фільтру вмісту LuLu_Plus."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus اس Wi-Fi نیٹ ورک کا نام (SSID) پڑھتا ہے تاکہ اس کے نیٹ ورک پروفائل مختلف نیٹ ورکوں پر مختلف قواعد لاگو کر سکیں۔ یہ نام صرف LuLu_Plus کے اپنے مواد فلٹر کو بھیجا جاتا ہے۔"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus 会读取当前 Wi-Fi 网络的名称（SSID），以便它的网络配置文件在不同网络上应用不同规则。该名称只会传给 LuLu_Plus 自己的内容过滤器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LuLu_Plus 會讀取目前 Wi-Fi 網路的名稱（SSID），以便它的網路設定檔在不同網路套用不同規則。該名稱只會傳給 LuLu_Plus 自己的內容過濾器。"
          }
        }
      }
    },
